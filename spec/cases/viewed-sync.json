{
  "rule": "viewed-sync",
  "about": "Re-send queued ticks in one call (`takes`: whether the host takes it), then merge the answer read before the re-send. `tried`: each call's ticks, in order.",
  "cases": [
    {
      "name": "a batch the host refuses stays queued whole, its ticks kept, not erased by the answer read before it went out",
      "given": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": true
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "UNVIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          }
        ],
        "takes": false
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": true
        },
        "tried": [
          {
            "a.kt": true,
            "b.kt": true
          }
        ]
      }
    },
    {
      "name": "a batch the host takes leaves the queue whole, and its ticks are kept, not erased by the answer read before it went out",
      "given": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": true
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "UNVIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          }
        ],
        "takes": true
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": null,
        "tried": [
          {
            "a.kt": true,
            "b.kt": true
          }
        ]
      }
    },
    {
      "name": "a queued tick for a file outside the PR on the host is dropped, never re-sent, and stays ticked here",
      "given": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2",
          "c.kt": "c2"
        },
        "unsent": {
          "a.kt": true,
          "c.kt": true
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          },
          {
            "path": "c.kt",
            "newBlob": "c2"
          }
        ],
        "takes": true
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2",
          "c.kt": "c2"
        },
        "unsent": null,
        "tried": [
          {
            "a.kt": true
          }
        ]
      }
    },
    {
      "name": "ticks and unticks go in one call",
      "given": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": false
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          }
        ],
        "takes": true
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": null,
        "tried": [
          {
            "a.kt": true,
            "b.kt": false
          }
        ]
      }
    },
    {
      "name": "nothing queued sends nothing",
      "given": {
        "reviewed": {},
        "unsent": null,
        "host": {
          "a.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          }
        ],
        "takes": false
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": null,
        "tried": []
      }
    }
  ]
}
