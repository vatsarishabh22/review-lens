{
  "rule": "viewed-sync",
  "about": "On load: fold the host's answer in, the queued ticks keeping this machine's value, and drop from the queue a path the host doesn't list (it stays ticked here). `unsent`: what is left to send, through the tick line.",
  "cases": [
    {
      "name": "queued ticks keep this machine's value, not erased by the answer read before they go, and stay queued for the tick line",
      "given": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": true
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "UNVIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          }
        ]
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": true
        }
      }
    },
    {
      "name": "a queued tick for a file outside the PR on the host leaves the queue, never sent, and stays ticked here",
      "given": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2",
          "c.kt": "c2"
        },
        "unsent": {
          "a.kt": true,
          "c.kt": true
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          },
          {
            "path": "c.kt",
            "newBlob": "c2"
          }
        ]
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2",
          "b.kt": "b2",
          "c.kt": "c2"
        },
        "unsent": {
          "a.kt": true
        }
      }
    },
    {
      "name": "ticks and unticks stay queued together, for one call",
      "given": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": false
        },
        "host": {
          "a.kt": "UNVIEWED",
          "b.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          },
          {
            "path": "b.kt",
            "newBlob": "b2"
          }
        ]
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": {
          "a.kt": true,
          "b.kt": false
        }
      }
    },
    {
      "name": "nothing queued leaves nothing to send",
      "given": {
        "reviewed": {},
        "unsent": null,
        "host": {
          "a.kt": "VIEWED"
        },
        "changes": [
          {
            "path": "a.kt",
            "newBlob": "a2"
          }
        ]
      },
      "expect": {
        "reviewed": {
          "a.kt": "a2"
        },
        "unsent": null
      }
    }
  ]
}
