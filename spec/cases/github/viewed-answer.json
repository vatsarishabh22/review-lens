{
  "rule": "github/viewed-answer",
  "about": "GitHub's Viewed answer, every page of VIEWED_QUERY (GitHub's real shape, PR #579): pages are joined, states it does not know are skipped.",
  "cases": [
    {
      "name": "pages joined, unknown states skipped",
      "given": {
        "pages": [
          {
            "repository": {
              "pullRequest": {
                "id": "PR_1",
                "files": {
                  "pageInfo": {
                    "hasNextPage": false,
                    "endCursor": null
                  },
                  "nodes": [
                    {
                      "path": ".github/a.yml",
                      "viewerViewedState": "VIEWED"
                    },
                    {
                      "path": ".github/b.yml",
                      "viewerViewedState": "UNVIEWED"
                    }
                  ]
                }
              }
            }
          },
          {
            "repository": {
              "pullRequest": {
                "id": "PR_1",
                "files": {
                  "pageInfo": {
                    "hasNextPage": false,
                    "endCursor": null
                  },
                  "nodes": [
                    {
                      "path": "src/c.kt",
                      "viewerViewedState": "DISMISSED"
                    },
                    {
                      "path": "src/d.kt",
                      "viewerViewedState": "SOMETHING_NEW"
                    }
                  ]
                }
              }
            }
          }
        ]
      },
      "expect": {
        "pullRequestId": "PR_1",
        "files": {
          ".github/a.yml": "VIEWED",
          ".github/b.yml": "UNVIEWED",
          "src/c.kt": "DISMISSED"
        }
      }
    },
    {
      "name": "an answer without the pull request is refused",
      "given": {
        "pages": [
          {
            "repository": {
              "pullRequest": null
            }
          }
        ]
      },
      "expect": {
        "error": true
      }
    }
  ]
}
