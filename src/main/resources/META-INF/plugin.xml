<idea-plugin>
    <id>io.github.vatsarishabh22.reviewlens</id>
    <name>Review Lens</name>
    <vendor>Rishabh Vatsa</vendor>
    <description><![CDATA[
        Review a GitHub PR inside the real codebase, in the same window: your work is parked, the PR is checked out
        read-only with its changes marked, and Exit review brings you back to your branch with your work restored.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>

    <extensions defaultExtensionNs="com.intellij">
        <writingAccessProvider implementation="io.github.vatsarishabh22.reviewlens.ReadOnlyGuard"/>
        <toolWindow id="Review" anchor="left" icon="AllIcons.Actions.Preview"
                    factoryClass="io.github.vatsarishabh22.reviewlens.ReviewToolWindowFactory"/>
        <editorNotificationProvider implementation="io.github.vatsarishabh22.reviewlens.ReviewBanner"/>
        <editor.linePainter implementation="io.github.vatsarishabh22.reviewlens.InlineBlame"/>
        <projectViewNodeDecorator implementation="io.github.vatsarishabh22.reviewlens.TreeBadges"/>
        <postStartupActivity implementation="io.github.vatsarishabh22.reviewlens.ReviewStartup"/>
        <notificationGroup id="Review Lens" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="ReviewLens.ReviewPr" class="io.github.vatsarishabh22.reviewlens.ReviewPrAction"
                text="Review PR…" description="Review a pull request in this window"
                icon="AllIcons.Actions.Preview">
            <add-to-group group-id="MainToolbarRight" anchor="first"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <action id="ReviewLens.MarkReviewed" class="io.github.vatsarishabh22.reviewlens.MarkReviewedAction"
                text="Mark Reviewed" description="Mark this file reviewed and open the next one"
                icon="AllIcons.Actions.Checked">
            <keyboard-shortcut keymap="$default" first-keystroke="alt R"/>
        </action>
        <action id="ReviewLens.NextFile" class="io.github.vatsarishabh22.reviewlens.NextFileAction"
                text="Next Unreviewed File" icon="AllIcons.Actions.Forward">
            <keyboard-shortcut keymap="$default" first-keystroke="alt N"/>
        </action>
        <action id="ReviewLens.ShowDiff" class="io.github.vatsarishabh22.reviewlens.ShowDiffAction"
                text="Show Review Diff" description="This file at the scope's base vs the PR" icon="AllIcons.Actions.Diff">
            <keyboard-shortcut keymap="$default" first-keystroke="alt D"/>
        </action>
        <action id="ReviewLens.ChangeScope" class="io.github.vatsarishabh22.reviewlens.ChangeScopeAction"
                text="Change Scope / Refresh…" description="Re-fetch the PR and pick commits again" icon="AllIcons.Actions.Refresh"/>
        <action id="ReviewLens.Exit" class="io.github.vatsarishabh22.reviewlens.ExitReviewAction"
                text="Exit Review" description="Go back to your branch and restore your parked changes" icon="AllIcons.Actions.Exit"/>

        <group id="ReviewLens.Toolbar">
            <reference ref="ReviewLens.NextFile"/>
            <reference ref="ReviewLens.ChangeScope"/>
            <separator/>
            <reference ref="ReviewLens.Exit"/>
        </group>
    </actions>
</idea-plugin>
